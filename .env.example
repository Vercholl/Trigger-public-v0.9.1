# trigger — пример переменных окружения
# Скопируйте в .env и заполните: cp .env.example .env && chmod 600 .env
# НИКАКИХ секретов в коде и миграциях. Все значения ниже — плейсхолдеры.

# --- БД (SQLite в этой сборке; путь к файлу) ---
DATABASE_URL=file:./db/custom.db

# Тенант (задел на будущее; система обслуживает одного тенанта)
TENANT_ID=trigger

# --- Первый администратор ---
# Создаётся при первом запуске. ПУСТЫЕ ЗНАЧЕНИЯ = приложение не стартует.
# При первом входе — принудительная смена пароля.
# ВАЖНО: если пароль содержит «#», обязательно заключите его в двойные кавычки:
# ADMIN_PASSWORD="pass#word" — иначе «#» и всё после него обрежется как комментарий.
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=<сгенерируйте стойкий пароль: openssl rand -base64 24>

# --- Секреты подписей (обязательно заменить!) ---
# Сессии панели
SESSION_SECRET=<openssl rand -hex 32>
# TTL сессии панели, часов (1..8760); пусто = 30 дней
SESSION_TTL_HOURS=
# Idle-таймаут сессии, часов без активности (0 = выключен); пусто = 168 (7 дней).
# Сокращает окно жизни угнанной/забытой сессии против абсолютного TTL
SESSION_IDLE_HOURS=
# HMAC-подпись токенов отписки (защита от отписки чужих клиентов перебором)
UNSUBSCRIBE_SECRET=<openssl rand -hex 32>
# Ключ шифрования секретов провайдеров в БД (AES-256-GCM): токен SMS.Tech,
# логин/пароль Т2 и МТС хранятся зашифрованными; пусто = выводится из SESSION_SECRET
SECRETS_KEY=<openssl rand -hex 32>

# --- Пароли (политика для НОВЫХ паролей; существующие не ретроактивны) ---
# Минимальная длина пароля (8..128); пусто = 10. Плюс: буквы + цифры,
# не email/имя, не из списка популярных, нельзя повторить 5 последних
PASSWORD_MIN_LENGTH=

# --- Приём событий ---
# Временный статический API-ключ (заголовок X-Api-Key) до полного механизма.
# Полный механизм (хеш, отзыв, IP-allowlist, пер-ключевой лимит) — «Интеграции» →
# «Интеграция с системой данных» → блок «API-ключи».
EVENTS_API_KEY=<openssl rand -hex 16>

# --- Лимиты интеграции (G6; все — запросов в минуту, пусто = дефолт) ---
# Пре-авторизационный IP-лимит приёма событий (анти-DoS до сверки ключа);
# 600 — запас для боевого адаптера системы данных (волны статусов), реальную защиту
# даёт пер-ключевой лимит ПОСЛЕ сверки
# EVENTS_IP_RATE_LIMIT_PER_MIN=600
# Дефолтный пер-ключевой лимит приёма событий: статический env-ключ и ключи
# БД без собственного значения (интеграционному ключу задаётся свой потолок
# в блоке «API-ключи» вкладки «Интеграция с системой данных» раздела
# «Интеграции» — поле «Лимит запросов/мин»)
# EVENTS_KEY_RATE_LIMIT_PER_MIN=120
# Пер-ключевой лимит батч-запросов POST /api/v1/events/batch (каждый несёт
# до 10 000 строк — стартовая загрузка 3 млн карточек укладывается в ~5 минут)
# EVENTS_BATCH_KEY_RATE_LIMIT_PER_MIN=60
# Лимит webhook-уведомлений провайдеров и приёмника внешнего захвата.
# Боевым контурам с пиками коллбэков МТС (напр. 50 тыс. СМС/час) рекомендуется 2000+
# WEBHOOK_RATE_LIMIT_PER_MIN=300

# --- SMS ---
# sandbox — имитация отправки (без реальных SMS), smstech — агрегатор SMS.Tech,
# t2 — оператор «Т2 Бизнес SMS», mts — оператор «МТС OmniChannel»
# (креды t2/mts — на вкладке «SMS-провайдеры» раздела «Интеграции»)
SMS_PROVIDER=sandbox

# Название рекламодателя для обязательного дисклеймера рекламных SMS
ADVERTISER_NAME=«Ваша компания»

# База ссылки отписки; пусто = строится от IP/Origin сервера (без домена)
UNSUBSCRIBE_BASE_URL=

# --- SMS.Tech (агрегатор; только при SMS_PROVIDER=smstech) ---
# Токен доступа: личный кабинет https://hub.sms.tech → «Интеграции» → «Токен пользователя».
# Бессрочный, передаётся в meta.access_token каждого запроса. Основной способ задать токен —
# поле «Токен доступа SMS.Tech» на вкладке «SMS-провайдеры» раздела «Интеграции»
# панели (А44, хранится в БД); эта переменная — fallback на случай, если
# в панели токен не сохраняли
SMSTECH_ACCESS_TOKEN=
# Базовый URL шлюза (пусто = https://sms-gate.smsleads.ru)
SMSTECH_BASE_URL=
# Значение заголовка Authorization webhook-а статусов: сообщается в поддержку SMS.Tech
# вместе с URL <домен>/api/v1/webhooks/smstech; пусто = проверка заголовка выключена
SMSTECH_WEBHOOK_SECRET=<произвольный секрет, напр. Bearer-токен>

# --- Т2 «Бизнес SMS» (оператор; только при SMS_PROVIDER=t2) ---
# Логин/пароль HTTP-рассылки: личный кабинет https://bsms.t2.ru → «Создать HTTP-рассылку»
# (после согласования с Т2). Основной способ задать креды — поля «Логин/Пароль Т2»
# на вкладке «SMS-провайдеры» раздела «Интеграции» панели (А44, хранятся в БД);
# эти переменные — fallback
T2_LOGIN=
T2_PASSWORD=
# Базовый URL шлюза (пусто = https://bsms.t2.ru); симулятор для отладки: https://bsms.t2.ru/simulator-api
T2_BASE_URL=
# Секрет webhook-а Т2: если задан, URL уведомлений для Т2 должен содержать ?secret=<значение>;
# пусто = проверка выключена
T2_WEBHOOK_SECRET=

# --- МТС OmniChannel (оператор; только при SMS_PROVIDER=mts) ---
# Логин (system_id) и пароль подключения выдаются при заключении договора с МТС;
# авторизация — Basic Authentication в каждом запросе к omnichannel.mts.ru.
# Основной способ задать креды — поля «Логин/Пароль МТС» на вкладке «SMS-провайдеры»
# раздела «Интеграции» панели (хранятся в БД зашифрованными); эти переменные — fallback
MTS_LOGIN=
MTS_PASSWORD=
# Базовый URL платформы (пусто = https://omnichannel.mts.ru); для приёмки без
# реальной отправки — STAGE-окружение с эмулятором https://stage.omnichannel.mts.ru
MTS_BASE_URL=
# Секрет webhook-а МТС: если задан, URL коллбэка, переданный менеджеру МТС,
# должен содержать ?secret=<значение>; пусто = проверка выключена
# (в самом протоколе МТС V.1.14 подписи коллбэков нет)
MTS_WEBHOOK_SECRET=

# --- SMS.RU (ЗАДЕЛ НА БУДУЩЕЕ — провайдер в реестр не подключён) ---
# Webhook статусов POST /api/v1/webhooks/smsru проверяет подпись
# md5(SMSRU_API_ID + sms_id + status + SMSRU_WEBHOOK_SECRET) — алгоритм
# ПРОВЕРИТЬ ПО ДОКУМЕНТАЦИИ SMS.RU перед использованием. Не заданы → 503.
SMSRU_API_ID=
SMSRU_WEBHOOK_SECRET=
# SMSRU_TEST_MODE=1       # тестовый режим шлюза без тарификации (только адаптер)

# Часовой пояс по умолчанию для новых клиентов (IANA, напр. Asia/Novosibirsk)
DEFAULT_TIMEZONE=Asia/Novosibirsk

# --- Канал сохранности данных песочницы (db-backup / db-restore) ---
# Воркер периодически снимает снапшот БД (VACUUM INTO, атомарная замена) и
# копию .env в /home/sync/db-backup; при старте «свежая» БД автоматически
# восстанавливается из снапшота (индикатор dataSnapshot в /api/health).
# Работает только при наличии каталога /home/sync (песочница платформы);
# на собственном сервере — тихий no-op, резервное копирование организуйте
# своими средствами (см. docs/security.md §9–10).
# TRIGGER_DB_BACKUP=off       # выключить снапшоты
# TRIGGER_DB_RESTORE=off      # выключить авто-восстановление при старте
# TRIGGER_DB_BACKUP_TICKS=    # интервал снапшотов в тиках воркера (5 с/тик); пусто =
#                         # адаптивно: БД ≤1 ГБ — раз в 5 мин, >1 ГБ — раз в 30 мин

# --- Безопасность развёртывания ---
# FRAME_PROTECTION=1 добавляет X-Frame-Options: DENY на каждый ответ (runtime,
# src/proxy.ts) — запрет встраивания панели в чужие iframe. Включайте на сервере
# компании, если панель НЕ встраивается в другие системы. По умолчанию выключено.
FRAME_PROTECTION=
# Прочие HTTP-заголовки безопасности (nosniff, Referrer-Policy, Permissions-Policy,
# HSTS, CSP) включаются автоматически в production-режиме — см. docs/security.md.

# --- Демо-пользователи для dev-сида (пусто = не создаётся) ---
MANAGER_EMAIL=
MANAGER_PASSWORD=
VIEWER_EMAIL=
VIEWER_PASSWORD=

# Публичный хост для ссылок отписки, если Origin запроса недоступен
SERVER_PUBLIC_HOST=
